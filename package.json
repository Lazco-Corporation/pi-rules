{
  "name": "@lazco/pi-rules",
  "version": "0.8.0",
  "description": "Pi extension: load Markdown rules into the agent context for the whole project or for matching files",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Lazco Corporation (拉資科科技有限公司)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lazco-Corporation/pi-rules.git"
  },
  "homepage": "https://github.com/Lazco-Corporation/pi-rules#readme",
  "bugs": {
    "url": "https://github.com/Lazco-Corporation/pi-rules/issues"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "coding-agent",
    "rules",
    "claude-code"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
